{
  "track": "transfer",
  "lessons": [
    {
      "id": "scp",
      "title": "Copying between your laptop and Geiss-01",
      "before": "transfer-01-download",
      "summary": "scp copies files over the same connection as ssh.",
      "blocks": [
        {
          "text": "Your results live on Geiss-01, but you'll want to open them in PyMOL or ChimeraX, or put them in a slide, on your own laptop. `scp` (secure copy) copies files between the two computers over the network."
        },
        {
          "warn": "Run scp in a terminal on your laptop, not on Geiss-01. Your laptop can reach Geiss-01 by name; Geiss-01 can't reach your laptop. In these exercises, Try it terminals marked \"Your laptop\" stand in for that."
        },
        {
          "command": {
            "name": "scp",
            "stands": "secure copy",
            "syntax": "scp SOURCE DESTINATION",
            "what": "Copies SOURCE to DESTINATION, like cp, except either one can be on another computer. A path on Geiss-01 is written `student@geiss-01:PATH`: user, @, computer name, a colon, then the path there."
          }
        },
        {
          "example": {
            "cmd": "scp student@geiss-01:~/project/results/design_3.pdb ~/Downloads/",
            "out": "design_3.pdb                    100%   48KB   1.2MB/s   00:00",
            "note": "Source: the file on Geiss-01. Destination: the Downloads folder on the laptop. The colon is what marks the remote side; forget it and scp copies to a local file named student@geiss-01."
          }
        },
        {
          "try": {
            "text": "On your laptop, download `~/project/results/design_3.pdb` from Geiss-01 into `~/Downloads/`.",
            "on": "laptop",
            "machines": {
              "cluster": {
                "cwd": "~/project",
                "files": {
                  "~/project/results/design_3.pdb": {
                    "lib": "pdb:complex"
                  },
                  "~/project/results/scores.csv": "name,score\ndesign_3,-330.9\n",
                  "~/project/runs/run1/a.pdb": {
                    "lib": "pdb:small"
                  },
                  "~/project/runs/run1/b.pdb": {
                    "lib": "pdb:small"
                  },
                  "~/project/inputs/": {}
                }
              },
              "laptop": {
                "cwd": "~",
                "files": {
                  "~/Documents/target_clean.pdb": {
                    "lib": "pdb:small"
                  }
                }
              }
            },
            "check": {
              "laptop": {
                "exists": "~/Downloads/design_3.pdb"
              }
            },
            "hint": "scp student@geiss-01:~/project/results/design_3.pdb ~/Downloads/",
            "solution": [
              {
                "laptop": "scp student@geiss-01:~/project/results/design_3.pdb ~/Downloads/"
              }
            ]
          }
        },
        {
          "tip": "`.` as the destination means \"the folder I'm in\": `scp student@geiss-01:~/project/results/scores.csv .`"
        },
        {
          "quiz": {
            "q": "Which is the correct way to write a file on Geiss-01 for scp?",
            "options": [
              "geiss-01/~/a.pdb",
              "student@geiss-01:~/a.pdb",
              "student@geiss-01~/a.pdb",
              "~/a.pdb@geiss-01"
            ],
            "answer": 1,
            "why": "user@computer, then a colon, then the path on that computer."
          }
        }
      ]
    },
    {
      "id": "upload",
      "title": "Uploading",
      "before": "transfer-03-upload",
      "summary": "Same command, sides swapped.",
      "blocks": [
        {
          "text": "To send a file up, put the laptop file first and the Geiss-01 location second. Order is always SOURCE then DESTINATION."
        },
        {
          "try": {
            "text": "From your laptop's Documents folder, upload `target_clean.pdb` into `~/project/inputs/` on Geiss-01.",
            "on": "laptop",
            "machines": {
              "cluster": {
                "cwd": "~/project",
                "files": {
                  "~/project/results/design_3.pdb": {
                    "lib": "pdb:complex"
                  },
                  "~/project/results/scores.csv": "name,score\ndesign_3,-330.9\n",
                  "~/project/runs/run1/a.pdb": {
                    "lib": "pdb:small"
                  },
                  "~/project/runs/run1/b.pdb": {
                    "lib": "pdb:small"
                  },
                  "~/project/inputs/": {}
                }
              },
              "laptop": {
                "cwd": "~/Documents",
                "files": {
                  "~/Documents/target_clean.pdb": {
                    "lib": "pdb:small"
                  }
                }
              }
            },
            "check": {
              "exists": "~/project/inputs/target_clean.pdb"
            },
            "hint": "scp target_clean.pdb student@geiss-01:~/project/inputs/",
            "solution": [
              {
                "laptop": "scp target_clean.pdb student@geiss-01:~/project/inputs/"
              }
            ]
          }
        },
        {
          "tip": "End a destination folder with `/`. If the folder doesn't exist, scp then says so instead of quietly creating a file with that name."
        },
        {
          "quiz": {
            "q": "`scp student@geiss-01:~/a.pdb b.pdb` run on your laptop. What happens?",
            "options": [
              "Uploads b.pdb",
              "Downloads a.pdb and saves it as b.pdb on the laptop",
              "Renames a.pdb on Geiss-01",
              "Error"
            ],
            "answer": 1,
            "why": "The source is on Geiss-01 and the destination is a local name, so it downloads and names the copy b.pdb."
          }
        }
      ]
    },
    {
      "id": "folders",
      "title": "Whole folders and many files",
      "before": "transfer-05-folder",
      "summary": "-r for folders, wildcards for sets of files.",
      "blocks": [
        {
          "flags": [
            [
              "-r",
              "recursive",
              "Copy a folder and everything inside it"
            ],
            [
              "'*.pdb' on the remote side",
              "wildcard",
              "Every matching file on Geiss-01; quote it so your laptop doesn't try to expand it"
            ]
          ]
        },
        {
          "try": {
            "text": "Download the whole folder `~/project/runs/run1` into your laptop's `~/Downloads/`.",
            "on": "laptop",
            "machines": {
              "cluster": {
                "cwd": "~/project",
                "files": {
                  "~/project/results/design_3.pdb": {
                    "lib": "pdb:complex"
                  },
                  "~/project/results/scores.csv": "name,score\ndesign_3,-330.9\n",
                  "~/project/runs/run1/a.pdb": {
                    "lib": "pdb:small"
                  },
                  "~/project/runs/run1/b.pdb": {
                    "lib": "pdb:small"
                  },
                  "~/project/inputs/": {}
                }
              },
              "laptop": {
                "cwd": "~",
                "files": {
                  "~/Documents/target_clean.pdb": {
                    "lib": "pdb:small"
                  }
                }
              }
            },
            "check": {
              "laptop": {
                "exists": "~/Downloads/run1/a.pdb"
              }
            },
            "hint": "scp -r student@geiss-01:~/project/runs/run1 ~/Downloads/",
            "solution": [
              {
                "laptop": "scp -r student@geiss-01:~/project/runs/run1 ~/Downloads/"
              }
            ]
          }
        },
        {
          "quiz": {
            "q": "You forgot -r when copying a folder. What happens?",
            "options": [
              "It copies anyway",
              "scp says it's not a regular file and copies nothing",
              "It copies only the first file",
              "It deletes the folder"
            ],
            "answer": 1,
            "why": "Without -r, scp refuses folders."
          }
        }
      ]
    },
    {
      "id": "bundle",
      "title": "Bundle first, then copy",
      "before": "transfer-08-bundle",
      "summary": "Thousands of small files transfer far faster as one archive.",
      "blocks": [
        {
          "text": "Copying a run with thousands of small files one by one is slow. Bundle it on Geiss-01 with tar, copy the single archive, and unpack it on your laptop. The Manage files track covers tar's letters."
        },
        {
          "try": {
            "text": "On Geiss-01, bundle `runs/run1` into `run1.tar.gz`.",
            "machines": {
              "cluster": {
                "cwd": "~/project",
                "files": {
                  "~/project/results/design_3.pdb": {
                    "lib": "pdb:complex"
                  },
                  "~/project/results/scores.csv": "name,score\ndesign_3,-330.9\n",
                  "~/project/runs/run1/a.pdb": {
                    "lib": "pdb:small"
                  },
                  "~/project/runs/run1/b.pdb": {
                    "lib": "pdb:small"
                  },
                  "~/project/inputs/": {}
                }
              },
              "laptop": {
                "cwd": "~",
                "files": {
                  "~/Documents/target_clean.pdb": {
                    "lib": "pdb:small"
                  }
                }
              }
            },
            "check": {
              "archiveHas": {
                "path": "~/project/run1.tar.gz",
                "names": [
                  "runs/run1/a.pdb"
                ]
              }
            },
            "hint": "tar -czf run1.tar.gz runs/run1",
            "solution": [
              "tar -czf run1.tar.gz runs/run1"
            ]
          }
        },
        {
          "try": {
            "text": "Now download `~/project/run1.tar.gz` to your laptop's `~/Downloads/`.",
            "on": "laptop",
            "machines": {
              "cluster": {
                "cwd": "~/project",
                "files": {
                  "~/project/results/design_3.pdb": {
                    "lib": "pdb:complex"
                  },
                  "~/project/results/scores.csv": "name,score\ndesign_3,-330.9\n",
                  "~/project/runs/run1/a.pdb": {
                    "lib": "pdb:small"
                  },
                  "~/project/runs/run1/b.pdb": {
                    "lib": "pdb:small"
                  },
                  "~/project/inputs/": {},
                  "~/project/run1.tar.gz": {
                    "archive": {
                      "gz": true,
                      "files": {
                        "runs/run1/a.pdb": {
                          "lib": "pdb:small"
                        }
                      }
                    }
                  }
                }
              },
              "laptop": {
                "cwd": "~",
                "files": {
                  "~/Documents/target_clean.pdb": {
                    "lib": "pdb:small"
                  }
                }
              }
            },
            "check": {
              "laptop": {
                "exists": "~/Downloads/run1.tar.gz"
              }
            },
            "hint": "scp student@geiss-01:~/project/run1.tar.gz ~/Downloads/",
            "solution": [
              {
                "laptop": "scp student@geiss-01:~/project/run1.tar.gz ~/Downloads/"
              }
            ]
          }
        },
        {
          "quiz": {
            "q": "After downloading run1.tar.gz, which command unpacks it on your laptop?",
            "options": [
              "tar -czf run1.tar.gz",
              "tar -xzf run1.tar.gz",
              "scp -r run1.tar.gz",
              "gzip run1.tar.gz"
            ],
            "answer": 1,
            "why": "x extracts, z decompresses, f names the archive."
          }
        }
      ]
    }
  ]
}