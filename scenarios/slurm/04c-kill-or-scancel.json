      "binder_design",
      "il7r_binders",
      "spike_minibinders",
      "pdl1_binders",
      "tnf_traps",
      "her2_binders"
    ],
    "job": [
      "rfd_scan",
      "af2_batch",
      "mpnn_big",
      "chai_set"
    ],
    "jid": [
      50317,
      50842,
      51466,
      51923
    ],
    "pid": [
      33141,
      34287,
      35720,
      36654
    ]
  },
  "machines": {
    "cluster": {
      "cwd": "~/{{project}}",
      "gpusBusy": 3,
      "jobs": [
        {
          "id": "{{jid}}",
          "name": "{{job}}",
          "gpus": 1,
          "memGB": 32,
          "state": "R",
          "startStep": -40,
          "runSteps": 100000,
          "timeMin": 1440,
          "memUsedGB": 18.4
        }
      ],
      "processes": [
        {
          "pid": "{{pid}}",
          "command": "python plot_scores.py scores.csv",
          "cpu": 98.9,
          "memGB": 3.8,
          "startStep": -200
        },
        {
          "pid": 29874,
          "user": "mlee",
          "command": "python plot_scores.py mlee_scores.csv",
          "cpu": 97.1,
          "memGB": 4.1,
          "startStep": -90
        }
      ]
    }
  },
  "tasks": [
    {
      "text": "Stop the Slurm job {{job}}",
      "check": {
        "jobState": {
          "name": "{{job}}",
          "state": "CA"
        }
      }
    },
    {
      "text": "Stop your plot_scores.py",
      "check": {
        "processGone": "plot_scores.py"
      }
    }
  ],
  "hints": [
    "Slurm jobs: `squeue --me`, then `scancel JOBID`. Processes you started yourself: find the PID with `ps ux` or `htop` (check the USER column), then `kill PID`."
  ],
  "solution": [
    "squeue --me",
    "scancel {{jid}}",
    "ps ux",
    "kill {{pid}}"
  ]
}
