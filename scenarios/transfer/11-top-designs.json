{
  "id": "transfer-11-top-designs",
  "track": "transfer",
  "order": 11,
  "tier": 4,
  "title": "Just the winners",
  "story": "top3.txt in ~/{{project}} on Geiss-01 lists the three best designs. The designs are in ~/{{project}}/designs. Put exactly those three PDB files into a folder called top in your laptop's Downloads.",
  "vars": {
    "project": [
      "binder_design",
      "il7r_binders",
      "spike_minibinders",
      "pdl1_binders",
      "tnf_traps",
      "her2_binders"
    ],
    "w": {
      "pick": 3,
      "from": [
        "des_011",
        "des_027",
        "des_034",
        "des_052",
        "des_068",
        "des_073",
        "des_081",
        "des_090"
      ]
    }
  },
  "machines": {
    "cluster": {
      "cwd": "~/{{project}}",
      "files": {
        "~/{{project}}/top3.txt": "{{w.0}}\n{{w.1}}\n{{w.2}}\n",
        "~/{{project}}/designs/des_0{{i}}.pdb": {
          "lib": "pdb:complex",
          "count": 9
        },
        "~/{{project}}/designs/{{w.0}}.pdb": {
          "lib": "pdb:complex"
        },
        "~/{{project}}/designs/{{w.1}}.pdb": {
          "lib": "pdb:complex"
        },
        "~/{{project}}/designs/{{w.2}}.pdb": {
          "lib": "pdb:complex"
        }
      }
    },
    "laptop": {
      "cwd": "~/Downloads"
    }
  },
  "tasks": [
    {
      "text": "~/Downloads/top holds exactly the three listed designs",
      "check": {
        "laptop": {
          "dirHas": {
            "path": "~/Downloads/top",
            "only": true,
            "names": [
              "{{w.0}}.pdb",
              "{{w.1}}.pdb",
              "{{w.2}}.pdb"
            ]
          }
        }
      }
    }
  ],
  "hints": [
    "Read top3.txt on Geiss-01. scp takes several sources before the destination."
  ],
  "solution": [
    "cat top3.txt",
    {
      "laptop": "mkdir top"
    },
    {
      "laptop": "scp student@geiss-01:~/{{project}}/designs/{{w.0}}.pdb student@geiss-01:~/{{project}}/designs/{{w.1}}.pdb student@geiss-01:~/{{project}}/designs/{{w.2}}.pdb top/"
    }
  ]
}
