  "hints": [
    "In the Geiss-01 tab, `find . -name {{file}}` shows where it is.",
    "Then in the Laptop tab: `scp student@geiss-01:~/{{project}}/{{deep}}/{{file}} ~/Downloads/`"
  ],
  "solution": [
    "find . -name {{file}}",
    {
      "laptop": "scp student@geiss-01:~/{{project}}/{{deep}}/{{file}} ~/Downloads/"
    }
  ]
}
