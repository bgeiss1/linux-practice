{
  "id": "transfer-04-full-path",
  "track": "transfer",
  "order": 4,
  "tier": 2,
  "title": "Where exactly is it?",
  "story": "Somewhere under ~/{{project}} on Geiss-01 is {{file}}. Find where it is, then download it to Downloads on your laptop.",
  "vars": {
    "project": [
      "binder_design",
      "il7r_binders",
      "spike_minibinders",
      "pdl1_binders",
      "tnf_traps",
      "her2_binders"
    ],
    "file": [
      "final_ranking.csv",
      "best_designs.fasta",
