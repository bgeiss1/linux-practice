{
  "id": "transfer-06-wildcard",
  "track": "transfer",
  "order": 6,
  "tier": 2,
  "title": "Only the PDBs",
  "story": "~/{{project}}/out on Geiss-01 is full of logs and checkpoints, but you only want the PDB files. Make a folder called designs in your laptop's Downloads, and copy just the PDBs into it.",
  "vars": {
    "project": [
      "binder_design",
      "il7r_binders",
      "spike_minibinders",
      "pdl1_binders",
      "tnf_traps",
      "her2_binders"
    ],
    "npdb": {
      "range": [
        3,
        5
      ]
    }
  },
  "machines": {
    "cluster": {
      "cwd": "~/{{project}}/out",
      "files": {
        "~/{{project}}/out/model_{{i}}.pdb": {
          "lib": "pdb:small",
          "count": "{{npdb}}"
        },
        "~/{{project}}/out/ckpt_{{i}}.pt": {
          "content": "w\n",
          "size": "800M",
          "count": 3
        },
        "~/{{project}}/out/run.log": "ok\n"
      }
    },
    "laptop": {
      "cwd": "~/Downloads"
    }
  },
  "tasks": [
    {
      "text": "Make ~/Downloads/designs on your laptop",
      "check": {
        "laptop": {
          "isDir": "~/Downloads/designs"
        }
      }
    },
    {
      "text": "Copy only the .pdb files into it",
      "check": {
        "laptop": {
          "all": [
            {
              "isFile": "~/Downloads/designs/model_01.pdb"
            },
            {
              "isFile": "~/Downloads/designs/model_03.pdb"
            },
            {
              "notExists": "~/Downloads/designs/run.log"
            },
            {
              "notExists": "~/Downloads/designs/ckpt_01.pt"
            }
          ]
        }
      }
    }
  ],
  "hints": [
    "A wildcard in the server path is expanded on the server. Make the folder first with `mkdir`.",
    "`mkdir designs`, then `scp student@geiss-01:~/{{project}}/out/*.pdb designs/`"
  ],
  "solution": [
    {
      "laptop": "mkdir designs"
    },
    {
      "laptop": "scp student@geiss-01:~/{{project}}/out/*.pdb designs/"
    }
  ]
}
