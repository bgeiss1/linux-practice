{
  "id": "transfer-08-bundle",
  "track": "transfer",
  "order": 8,
  "tier": 3,
  "title": "Bundle, then download",
  "story": "{{run}} has hundreds of small files, which scp copies slowly one at a time. On Geiss-01, pack the {{run}} folder into {{run}}.tar.gz, then download that one file to Downloads on your laptop.",
  "vars": {
    "project": [
      "binder_design",
      "il7r_binders",
      "spike_minibinders",
      "pdl1_binders",
      "tnf_traps",
      "her2_binders"
    ],
    "run": [
      "run_01",
      "run_02",
      "run_03",
      "run_04",
      "run_05",
      "run_06",
      "run_07",
      "run_08"
    ]
  },
  "machines": {
    "cluster": {
      "cwd": "~/{{project}}/runs",
      "files": {
        "~/{{project}}/runs/{{run}}/traj/frame_{{i}}.pdb": {
          "lib": "pdb:small",
          "count": 12
        },
        "~/{{project}}/runs/{{run}}/scores.sc": "SCORE: -280\n"
      }
    },
    "laptop": {
      "cwd": "~"
    }
  },
  "tasks": [
    {
      "text": "Make {{run}}.tar.gz on Geiss-01",
      "check": {
        "archiveHas": {
          "path": "~/{{project}}/runs/{{run}}.tar.gz",
          "names": [
            "{{run}}/scores.sc"
          ]
        }
      }
    },
    {
      "text": "Download it to ~/Downloads on your laptop",
      "check": {
        "laptop": {
          "archiveHas": {
            "path": "~/Downloads/{{run}}.tar.gz",
            "names": [
              "{{run}}/scores.sc"
            ]
          }
        }
      }
    }
  ],
  "hints": [
    "`tar -czf {{run}}.tar.gz {{run}}` in the Geiss-01 tab, then `scp` the .tar.gz from the Laptop tab."
  ],
  "solution": [
    "tar -czf {{run}}.tar.gz {{run}}",
    {
      "laptop": "scp student@geiss-01:~/{{project}}/runs/{{run}}.tar.gz ~/Downloads/"
    }
  ]
}
