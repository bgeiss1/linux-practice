{
  "id": "transfer-07-upload-folder",
  "track": "transfer",
  "order": 7,
  "tier": 2,
  "title": "Upload a set of targets",
  "story": "Your PI sent you a folder of new targets, new_targets, now in your laptop's Downloads. Upload the whole folder into ~/{{project}}/inputs on Geiss-01.",
  "vars": {
    "project": [
      "binder_design",
      "il7r_binders",
      "spike_minibinders",
      "pdl1_binders",
      "tnf_traps",
      "her2_binders"
    ],
    "targets": {
      "pick": 3,
      "from": [
        "pdl1",
        "il7r",
        "her2",
        "tnfa",
        "egfr",
        "vegfa"
      ]
    }
  },
  "machines": {
    "cluster": {
      "cwd": "~/{{project}}",
      "files": {
        "~/{{project}}/inputs/": {}
      }
    },
    "laptop": {
      "cwd": "~/Downloads",
      "files": {
        "~/Downloads/new_targets/{{targets.0}}.pdb": {
          "lib": "pdb:small"
        },
        "~/Downloads/new_targets/{{targets.1}}.pdb": {
          "lib": "pdb:small"
        },
        "~/Downloads/new_targets/{{targets.2}}.pdb": {
          "lib": "pdb:small"
        }
      }
    }
  },
  "tasks": [
    {
      "text": "Upload new_targets to ~/{{project}}/inputs on Geiss-01",
      "check": {
        "dirHas": {
          "path": "~/{{project}}/inputs/new_targets",
          "names": [
            "{{targets.0}}.pdb",
            "{{targets.1}}.pdb",
            "{{targets.2}}.pdb"
          ]
        }
      }
    }
  ],
  "hints": [
    "Upload with the local folder first and `-r`.",
    "`scp -r new_targets student@geiss-01:~/{{project}}/inputs/`"
  ],
  "solution": [
    {
      "laptop": "scp -r new_targets student@geiss-01:~/{{project}}/inputs/"
    }
  ]
}
