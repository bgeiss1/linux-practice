{
  "id": "colabfold-09-oom",
  "track": "colabfold",
  "order": 9,
  "tier": 3,
  "title": "Too big for its memory",
  "story": "fold_big.sh folds {{b.0}} with a 640-residue receptor, a big complex. Submit it and see how it ends. If it fails, find out why with sacct and seff, and run it again so it succeeds. Give it what it needs, but don't ask for more than 48 GB, the most one student can hold.",
  "vars": {
    "project": [
      "binder_design",
      "il7r_binders",
      "spike_minibinders",
      "pdl1_binders",
      "tnf_traps",
      "her2_binders"
    ],
    "b": [
      [
        "binder_01",
        "MLEPPKKADEKLDIVLVDADELKVLIRAALVKLLEEAKEELKKAEREEPLRLELIARKEVERDIRKAEVLEKLEKLKKLAADKIE",
        ""
      ],
      [
        "des_4471",
        "MKIDIALPEALKKALGKEKAGLEEALPRKKKIDLPERKEADELDKLKLLKPELPARKEVRKEKLGKEIGLLLIALKEREDKLKIR",
        ""
      ],
      [
        "il7r_min",
        "MAVEIAEEKKKLGELEDKRKEALLRAKLLAALAAAAAAEILLELPVAAAKRKEKEERVKDRVDKEEAALELKLVLEAPRKKPEEL",
        ""
      ],
      [
        "pdl1_b3",
        "MLEPIKDADEAEKRLAEVEELLRAAAEKREPAKELPAKEEPALAKKAEALEAEIEAEGKAIEEVLAVELELLAIRAEKARKEELI",
        ""
      ]
    ]
  },
  "machines": {
    "cluster": {
      "cwd": "~/{{project}}",
      "liveJobs": true,
      "files": {
        "~/{{project}}/big_complex.fasta": ">{{b.0}}_receptor\n{{b.1}}:{{b.2}}\n",
        "~/{{project}}/fold_big.sh": "#!/bin/bash\n#SBATCH --job-name=fold_big\n#SBATCH --partition=gpu\n#SBATCH --gres=gpu:1\n#SBATCH --mem=16G\n#SBATCH --time=02:00:00\n#SBATCH --output=fold_big-%j.out\n\nmodule load colabfold\ncolabfold_batch big_complex.fasta big_af\n"
      }
    }
  },
  "tasks": [
    {
      "text": "Submit fold_big.sh and let it finish",
      "check": {
        "any": [
          {
            "jobState": {
              "name": "fold_big",
              "state": "OOM"
            }
          },
          {
            "jobState": {
              "name": "fold_big",
              "state": "CD"
            }
          }
        ]
      }
    },
    {
      "text": "Get a run that completes",
      "check": {
        "all": [
          {
            "jobState": {
              "name": "fold_big",
              "state": "CD"
            }
          },
          {
            "isFile": "~/{{project}}/big_af/{{b.0}}_receptor.done.txt"
          },
          {
            "not": {
              "jobSubmitted": {
                "name": "fold_big",
                "memGB": 49
              }
            }
          }
        ]
      }
    }
  ],
  "hints": [
    "`sacct` says OUT_OF_MEMORY and `seff JOBID` shows it used all 16 GB. Submit again with more: `sbatch --mem=48G fold_big.sh`."
  ],
  "solution": [
    "sbatch fold_big.sh",
    "squeue --me",
    "squeue --me",
    "squeue --me",
    "squeue --me",
    "squeue --me",
    "sacct",
    "seff 48215",
    "sbatch --mem=48G fold_big.sh",
    "squeue --me",
    "squeue --me",
    "squeue --me",
    "squeue --me",
    "squeue --me"
  ]
}
