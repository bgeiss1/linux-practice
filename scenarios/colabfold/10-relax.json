  "hints": [
    "The script needs `#SBATCH --gres=gpu:1` and `--mem=32G`, then `module load colabfold` and `colabfold_batch --amber {{r.0}}.fasta {{r.0}}_af`. Relaxed files have `relaxed` instead of `unrelaxed` in their names."
  ],
  "solution": [
    {
      "nano": "relax.sh",
      "text": "#!/bin/bash\n#SBATCH --job-name=relax\n#SBATCH --gres=gpu:1\n#SBATCH --mem=32G\n#SBATCH --time=02:00:00\n\nmodule load colabfold\ncolabfold_batch --amber {{r.0}}.fasta {{r.0}}_af\n"
