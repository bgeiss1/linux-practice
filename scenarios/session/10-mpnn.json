{
  "id": "session-10-mpnn",
  "track": "session",
  "order": 10,
  "tier": 3,
  "title": "Design sequences interactively",
  "story": "Run ProteinMPNN on inputs/{{target}}_complex.pdb, writing to the outputs folder. You'll need a GPU, the anaconda module, and the proteinmpnn environment.",
  "vars": {
    "project": [
      "binder_design",
      "il7r_binders",
      "spike_minibinders",
      "pdl1_binders",
      "tnf_traps",
      "her2_binders"
    ],
    "target": [
      "pdl1",
      "il7r",
      "her2",
      "tnfa",
      "egfr",
      "vegfa"
    ]
  },
  "machines": {
    "cluster": {
      "cwd": "~/{{project}}",
      "files": {
        "~/{{project}}/inputs/{{target}}_complex.pdb": {
          "lib": "pdb:complex"
        },
        "~/{{project}}/outputs/": {}
      }
    }
  },
  "tasks": [
    {
      "text": "Run protein_mpnn_run.py so outputs/seqs/{{target}}_complex.fa exists",
      "check": {
        "isFile": "~/{{project}}/outputs/seqs/{{target}}_complex.fa"
      }
    }
  ],
  "hints": [
    "`srun --gres=gpu:1 --pty bash`, `module load anaconda`, `conda activate proteinmpnn`, then `protein_mpnn_run.py --pdb_path inputs/{{target}}_complex.pdb --out_folder outputs`."
  ],
  "solution": [
    "srun --gres=gpu:1 --pty bash",
    "module load anaconda",
    "conda activate proteinmpnn",
    "protein_mpnn_run.py --pdb_path inputs/{{target}}_complex.pdb --out_folder outputs"
  ]
}
