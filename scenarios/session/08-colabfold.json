{
  "id": "session-08-colabfold",
  "track": "session",
  "order": 8,
  "tier": 2,
  "title": "Fold a sequence",
  "story": "Fold {{seq}}.fasta with ColabFold, writing results to a folder called {{seq}}_af. ColabFold needs its module and a GPU.",
  "vars": {
    "seq": [
      "binder_01",
      "des_4471",
      "il7r_min",
      "pdl1_b3"
    ],
    "project": [
      "binder_design",
      "il7r_binders",
      "spike_minibinders",
      "pdl1_binders",
      "tnf_traps",
      "her2_binders"
    ]
  },
  "machines": {
    "cluster": {
      "cwd": "~/{{project}}",
      "files": {
        "~/{{project}}/{{seq}}.fasta": ">{{seq}}\nMSEELLKKAEELIKRAKELGDPELVKRAL\n"
      }
    }
  },
  "tasks": [
    {
      "text": "Get a GPU and load colabfold",
      "check": {
        "all": [
          {
            "inInteractiveJob": 1
          },
          {
            "moduleLoaded": "colabfold"
          }
        ]
      }
    },
    {
      "text": "Run colabfold_batch {{seq}}.fasta {{seq}}_af",
      "check": {
        "isFile": "~/{{project}}/{{seq}}_af/log.txt"
      }
    }
  ],
  "hints": [
    "Order matters only for the run: get the GPU with `srun --gres=gpu:1 --pty bash`, load the module, then run the tool.",
    "`srun --gres=gpu:1 --pty bash`, `module load colabfold`, then `colabfold_batch {{seq}}.fasta {{seq}}_af`."
  ],
  "solution": [
    "srun --gres=gpu:1 --pty bash",
    "module load colabfold",
    "colabfold_batch {{seq}}.fasta {{seq}}_af"
  ]
}
