{
  "id": "gromacs-04-solvate",
  "track": "gromacs",
  "order": 4,
  "tier": 2,
  "title": "Fill the box with water",
  "story": "Fill the box in 1AKI_newbox.gro with water using solvate and the spc216.gro water box that comes with GROMACS. Write the result to 1AKI_solv.gro and make sure the waters are also added to topol.top. How many water molecules were added? Type the number in the answer box.",
  "lesson": {
    "title": "solvate: add water",
    "parts": [
      {
        "code": "gmx solvate",
        "note": "Fills empty space in the box with water."
      },
      {
        "code": "-cp 1AKI_newbox.gro",
        "note": "The solute: your protein in its box."
      },
      {
        "code": "-cs spc216.gro",
        "note": "The solvent: a small box of equilibrated water that GROMACS repeats to fill yours."
      },
      {
        "code": "-o 1AKI_solv.gro",
        "note": "Protein plus water."
      },
      {
        "code": "-p topol.top",
        "note": "Also add a SOL line to the topology, so it matches the new coordinates."
      }
    ],
    "without": "Without `-p topol.top` the coordinates have thousands of waters the topology doesn't know about, and the next step fails."
  },
  "vars": {
    "dir": [
      "lysozyme_md",
      "md_practice",
      "lyz_water",
      "mip662_md"
    ]
  },
  "machines": {
