{
  "version": 2,
  "term": "Fall 2026",
  "tracks": [
    {
      "id": "session",
      "title": "Start a session",
      "keyword": "heron",
      "blurb": "Log in, check the GPUs, ask Slurm for them, and load your software.",
      "commands": [
        "whoami",
        "hostname",
        "sinfo",
        "nvidia-smi",
        "srun",
        "module",
        "conda",
        "which",
        "exit"
      ],
      "scenarios": [
        "session/01-who-where",
        "session/02-gpus",
        "session/03-module-avail",
        "session/04-module-load",
        "session/05-conda",
        "session/06-interactive",
        "session/07-partitions",
        "session/08-one-command",
        "session/09-big-request",
        "session/10-which-python",
        "session/11-forgotten",
        "session/12-workday"
      ]
    },
    {
      "id": "navigate",
      "title": "Navigate",
      "keyword": "otter",
      "blurb": "Know where you are and move anywhere with relative and absolute paths.",
      "commands": [
        "pwd",
        "cd",
        "ls",
        "ls -a"
      ],
      "scenarios": [
        "navigate/01-where-am-i",
        "navigate/02-up-and-home",
